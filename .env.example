# Fill these values locally. Do not paste credentials into chat.
# All three provider keys are needed to validate the complete model support.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Needed for actual Google sign-in; separate from the Gemini API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local Atlas configuration. Port 8000 belongs to another project on this machine.
ATLAS_BASE_URL=http://localhost:8001
ATLAS_API_CAP_INR=500
ATLAS_DEMO_ENABLED=true
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Comma-separated Google emails allowed to sign in. Set before any public deployment.
ATLAS_ALLOWED_EMAILS=
